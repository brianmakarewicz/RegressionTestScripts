
# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

#Client environment files
environments/.env.*
!environments/.env.example

# Local run profiles may contain client/user mappings.
environments/run-profiles/*.json
!environments/run-profiles/*.example.json

# Local test data
test-data/**
!test-data/**/
!test-data/.gitkeep
!test-data/README.md
!test-data/**/*.example.*
!test-data/**/example.*
!test-data/**/.gitkeep

# Local output logs
output/**
!output/**/
!output/.gitkeep
!output/README.md
!output/**/*.example.*
!output/**/example.*
!output/**/.gitkeep
