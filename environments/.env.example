# Runtime selectors — set these in the terminal before running Playwright.
# TEST_DATA_ALIAS=c001 # Required only when a test loads client JSON.
# ENVIRONMENT=dev
# CLIENT_ALIAS=c001 # Required when a test logs into Oracle.

# Credential values — store these in
# environments/.env.<client-alias>.<environment>.
ORACLE_BASE_URL=https://example.oraclecloud.com
ORACLE_USERNAME=myusername
ORACLE_PASSWORD=mypassword
